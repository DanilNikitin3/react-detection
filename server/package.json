{
  "name": "my-express-server",
  "version": "1.0.0",
  "description": "Простой сервер на Express",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "https": "node server.js --https",
    "ssl-generate": "openssl req -x509 -newkey rsa:2048 -nodes -sha256 -subj '/CN=localhost' -keyout server.key -out server.crt",
    "generate-keys": "node -e \"console.log(require('web-push').generateVAPIDKeys())\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "noble": "^1.9.1",
    "node": "^24.8.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1"
  },
  "author": "Ваше имя",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
